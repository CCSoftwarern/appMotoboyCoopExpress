{
  "expo": {
    "name": "CoopExpress Motoboy",
    "slug": "appMotoboyCoopExpress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appmotoboycoopexpress",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.coopexpress.motoboy",
      "infoPlist": {
        "NSCameraUsageDescription": "A CoopExpress usa a câmera para fotografar a prova de entrega.",
        "NSLocationWhenInUseUsageDescription": "A CoopExpress usa sua localização para registrar a prova de entrega.",
        "NSPhotoLibraryUsageDescription": "A CoopExpress usa a galeria para anexar a prova de entrega."
      }
    },
    "android": {
      "package": "com.coopexpress.motoboy",
      "adaptiveIcon": {
        "backgroundColor": "#16A34A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16A34A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#16A34A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A CoopExpress usa a galeria para anexar a prova de entrega.",
          "cameraPermission": "A CoopExpress usa a câmera para fotografar a prova de entrega."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A CoopExpress usa sua localização para registrar a prova de entrega."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "626009b4-f2a8-43c0-9d5a-0402a9406e4d"
      }
    },
    "owner": "claudemyr"
  }
}
